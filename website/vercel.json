{
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "redirects": [
    { "source": "/cafe", "destination": "https://www.buymeacoffee.com/getborda", "permanent": false },
    { "source": "/github", "destination": "https://github.com/arthurfava/Borda", "permanent": false }
  ]
}
